# A3 Agent Registry & Governance (agent-registry) - example environment.
# Copy to .env for local development. .env is gitignored; never commit secrets. Optional values
# stay COMMENTED while absent: ``NAME=`` is an explicit empty runtime configuration and refuses.

# ---------------------------------------------------------------------------- #
# Deployment profile (gcp | local | onprem)
# ---------------------------------------------------------------------------- #
# The dev / test default is 'local': a WORKING offline SQLite catalog, SDK-free, no
# API key, no emulator required. Production explicitly selects 'gcp'; 'onprem' is the
# fail-fast Google Distributed Cloud migration target (exits 2).
AGENT_REGISTRY_PROFILE=local

# ---------------------------------------------------------------------------- #
# local profile (SDK-free SQLite catalog)
# ---------------------------------------------------------------------------- #
# Unset => per-package default under ~/.agent_registry/local.db. Uncomment with a non-empty path
# to pin the catalog file (tests use an in-memory store; the CLI smoke uses a temp file).
# AGENT_REGISTRY_LOCAL_DB=/path/to/agent-registry.db

# Optional, higher-fidelity local dev: route the local catalog to Google's official
# Firestore emulator. Only used when this is set AND google-cloud-firestore (the [gcp]
# extra) is importable; otherwise the SDK-free SQLite path is used. Never required.
# FIRESTORE_EMULATOR_HOST=localhost:8080

# ---------------------------------------------------------------------------- #
# gcp profile (managed AlloyDB / Firestore catalog) - unset under local
# ---------------------------------------------------------------------------- #
GOOGLE_CLOUD_PROJECT=your-gcp-project
GCP_REGION=asia-southeast1
AGENT_REGISTRY_BACKEND=alloydb              # alloydb | firestore
# AGENT_REGISTRY_KMS_KEY=projects/.../cryptoKeys/...       # regional CMEK
# AGENT_REGISTRY_ALLOYDB_URI=projects/.../instances/...
AGENT_REGISTRY_FIRESTORE_DB=(default)
AGENT_REGISTRY_PUBLIC_URL=https://agent-registry.asia-southeast1.run.app
# Managed release verification reads immutable evidence directly from model-quality-gate and agent-observability.
# QUALITY_GATE_URL=https://hrz4.example.test
# OBSERVABILITY_URL=https://hrz5.example.test
# RELEASE_POLICY_VERSION=reviewed-policy-v1
# RELEASE_DATASET_ID=reviewed-dataset
# RELEASE_DATASET_VERSION=v1
# RELEASE_DATASET_DIGEST=sha256:REPLACE_ME
# RELEASE_EVALUATOR=hrz4
# RELEASE_THRESHOLD_POLICY_DIGEST=sha256:REPLACE_ME
# RELEASE_ARTIFACT_PREFIXES=projects/.../locations/...
# RELEASE_REDTEAM_CATEGORIES=prompt_injection,jailbreak
# AGENT_REGISTRY_CATALOG_ATTESTATION_REF=evidence://REPLACE_ME
# AGENT_REGISTRY_IDENTITY_ATTESTATION_REF=evidence://REPLACE_ME
# AGENT_REGISTRY_RELEASE_ATTESTATION_REF=evidence://REPLACE_ME
# AGENT_REGISTRY_AUDIT_ATTESTATION_REF=evidence://REPLACE_ME
